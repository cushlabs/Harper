# Build the app first:  ./mvnw package   (or: mvn package)
# Then build the image:  docker build -f src/main/docker/Dockerfile.jvm -t harper/harper-service:0.1.0 .
# (Or skip Docker entirely and use Jib:  mvn package -Dquarkus.container-image.build=true)
#
# ubi9 openjdk-17-runtime: the JRE-only variant, so no compiler or build tooling ships
# in the runtime image. Pin the minor tag and let Dependabot move it; :latest would
# make builds unreproducible.
FROM registry.access.redhat.com/ubi9/openjdk-17-runtime:1.22

ENV LANGUAGE='en_US:en'

COPY --chown=185 target/quarkus-app/lib/ /deployments/lib/
COPY --chown=185 target/quarkus-app/*.jar /deployments/
COPY --chown=185 target/quarkus-app/app/ /deployments/app/
COPY --chown=185 target/quarkus-app/quarkus/ /deployments/quarkus/

EXPOSE 8080
USER 185
ENV JAVA_OPTS_APPEND="-Dquarkus.http.host=0.0.0.0 -Djava.util.logging.manager=org.jboss.logmanager.LogManager"
ENV JAVA_APP_JAR="/deployments/quarkus-run.jar"

ENTRYPOINT [ "/opt/jboss/container/java/run/run-java.sh" ]
