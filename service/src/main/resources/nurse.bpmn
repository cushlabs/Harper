        <dc:Bounds x="930" y="30" width="36" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Edge_nf1" bpmnElement="nf1">
        <di:waypoint x="188" y="480.0" />
        <di:waypoint x="240" y="480.0" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_nf2" bpmnElement="nf2">
        <di:waypoint x="360" y="480.0" />
        <di:waypoint x="410" y="480.0" />
      </bpmndi:BPMNEdge>
