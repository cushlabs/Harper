        <dc:Bounds x="300" y="560" width="36" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Data_HighRiskCC" bpmnElement="Data_HighRiskCC">
        <dc:Bounds x="300" y="650" width="36" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Data_AgeYears" bpmnElement="Data_AgeYears">
        <dc:Bounds x="300" y="740" width="36" height="50" />
      </bpmndi:BPMNShape>
