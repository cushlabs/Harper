<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_Process_Nurse_Sub" targetNamespace="http://harper.health/bpmn/nurse" exporter="Project Harper (reconstructed from diagram)" exporterVersion="0.3">
  <bpmn:itemDefinition id="ItemBoolean" structureRef="java.lang.Boolean" />
  <bpmn:itemDefinition id="ItemString" structureRef="java.lang.String" />
  <bpmn:process id="Process_Nurse_Sub" name="Nurse (sub-process)" isExecutable="true">
    <bpmn:documentation>Expanded Nurse sub-process. ED Prescreen and Screening Tool of Greenbaum are Kogito DMN business-rule tasks. A positive (at-risk) determination raises a DRAFT social-work referral (FHIR Task status draft) and throws the &#x27;Referral drafted&#x27; signal, which is what starts the Practitioner swimlane. The draft does NOT route; the Practitioner finalizes it, which is the single point that signals the Social Worker.</bpmn:documentation>
    <bpmn:property id="Prop_shouldScreen" name="shouldScreen" itemSubjectRef="ItemBoolean" />
    <bpmn:property id="Prop_atRisk" name="atRisk" itemSubjectRef="ItemBoolean" />
    <bpmn:property id="Prop_referralStatus" name="referralStatus" itemSubjectRef="ItemString" />
    <bpmn:startEvent id="StartEvent_Nurse" name="">
      <bpmn:outgoing>nf1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:manualTask id="ManualTask_TriageData" name="Nurse Triage Data Collection">
      <bpmn:incoming>nf1</bpmn:incoming>
      <bpmn:outgoing>nf2</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:businessRuleTask id="BusinessRuleTask_EDPrescreen" name="ED Prescreen" implementation="http://www.jboss.org/drools/dmn">
      <bpmn:documentation>Kogito DMN call. namespace=http://harper.health/dmn/ed-prescreen, model=&#x27;ED Prescreen&#x27;, decision=&#x27;ED Prescreen&#x27;. Output: shouldScreen.</bpmn:documentation>
      <bpmn:incoming>nf2</bpmn:incoming>
      <bpmn:outgoing>nf3</bpmn:outgoing>
      <bpmn:ioSpecification>
        <bpmn:dataInput id="BusinessRuleTask_EDPrescreen_namespace" name="namespace" />
        <bpmn:dataInput id="BusinessRuleTask_EDPrescreen_model" name="model" />
        <bpmn:dataInput id="BusinessRuleTask_EDPrescreen_decision" name="decision" />
        <bpmn:dataInput id="BusinessRuleTask_EDPrescreen_di_standingOrder" name="standingOrder" />
        <bpmn:dataInput id="BusinessRuleTask_EDPrescreen_di_highRiskChiefComplaint" name="highRiskChiefComplaint" />
        <bpmn:dataInput id="BusinessRuleTask_EDPrescreen_di_ageInYears" name="ageInYears" />
        <bpmn:dataOutput id="BusinessRuleTask_EDPrescreen_do" name="shouldScreen" />
        <bpmn:inputSet>
          <bpmn:dataInputRefs>BusinessRuleTask_EDPrescreen_namespace</bpmn:dataInputRefs>
          <bpmn:dataInputRefs>BusinessRuleTask_EDPrescreen_model</bpmn:dataInputRefs>
          <bpmn:dataInputRefs>BusinessRuleTask_EDPrescreen_decision</bpmn:dataInputRefs>
          <bpmn:dataInputRefs>BusinessRuleTask_EDPrescreen_di_standingOrder</bpmn:dataInputRefs>
          <bpmn:dataInputRefs>BusinessRuleTask_EDPrescreen_di_highRiskChiefComplaint</bpmn:dataInputRefs>
          <bpmn:dataInputRefs>BusinessRuleTask_EDPrescreen_di_ageInYears</bpmn:dataInputRefs>
        </bpmn:inputSet>
        <bpmn:outputSet><bpmn:dataOutputRefs>BusinessRuleTask_EDPrescreen_do</bpmn:dataOutputRefs></bpmn:outputSet>
      </bpmn:ioSpecification>
      <bpmn:dataInputAssociation id="BusinessRuleTask_EDPrescreen_a_namespace">
        <bpmn:targetRef>BusinessRuleTask_EDPrescreen_namespace</bpmn:targetRef>
        <bpmn:assignment><bpmn:from>http://harper.health/dmn/ed-prescreen</bpmn:from><bpmn:to>BusinessRuleTask_EDPrescreen_namespace</bpmn:to></bpmn:assignment>
      </bpmn:dataInputAssociation>
      <bpmn:dataInputAssociation id="BusinessRuleTask_EDPrescreen_a_model">
        <bpmn:targetRef>BusinessRuleTask_EDPrescreen_model</bpmn:targetRef>
        <bpmn:assignment><bpmn:from>EDPrescreen</bpmn:from><bpmn:to>BusinessRuleTask_EDPrescreen_model</bpmn:to></bpmn:assignment>
      </bpmn:dataInputAssociation>
      <bpmn:dataInputAssociation id="BusinessRuleTask_EDPrescreen_a_decision">
        <bpmn:targetRef>BusinessRuleTask_EDPrescreen_decision</bpmn:targetRef>
        <bpmn:assignment><bpmn:from>ED Prescreen</bpmn:from><bpmn:to>BusinessRuleTask_EDPrescreen_decision</bpmn:to></bpmn:assignment>
      </bpmn:dataInputAssociation>
      <bpmn:dataInputAssociation id="na1">
        <bpmn:sourceRef>Data_StandingOrder</bpmn:sourceRef>
        <bpmn:targetRef>BusinessRuleTask_EDPrescreen_di_standingOrder</bpmn:targetRef>
      </bpmn:dataInputAssociation>
      <bpmn:dataInputAssociation id="na2">
        <bpmn:sourceRef>Data_HighRiskCC</bpmn:sourceRef>
        <bpmn:targetRef>BusinessRuleTask_EDPrescreen_di_highRiskChiefComplaint</bpmn:targetRef>
      </bpmn:dataInputAssociation>
      <bpmn:dataInputAssociation id="na3">
        <bpmn:sourceRef>Data_AgeYears</bpmn:sourceRef>
        <bpmn:targetRef>BusinessRuleTask_EDPrescreen_di_ageInYears</bpmn:targetRef>
      </bpmn:dataInputAssociation>
      <bpmn:dataOutputAssociation id="BusinessRuleTask_EDPrescreen_doa">
        <bpmn:sourceRef>BusinessRuleTask_EDPrescreen_do</bpmn:sourceRef>
        <bpmn:targetRef>Prop_shouldScreen</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:businessRuleTask>
    <bpmn:exclusiveGateway id="Gateway_Screen" name="Screen?" gatewayDirection="Diverging" default="nf10">
      <bpmn:incoming>nf3</bpmn:incoming>
      <bpmn:outgoing>nf4</bpmn:outgoing>
      <bpmn:outgoing>nf10</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:manualTask id="ManualTask_NurseCollects" name="Nurse collects information">
      <bpmn:incoming>nf4</bpmn:incoming>
      <bpmn:outgoing>nf5</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:businessRuleTask id="BusinessRuleTask_Greenbaum" name="Screening Tool of Greenbaum" implementation="http://www.jboss.org/drools/dmn">
      <bpmn:documentation>Kogito DMN call. namespace=http://harper.health/dmn/greenbaum, model=&#x27;Screening Tool of Greenbaum&#x27;, decision=&#x27;Screening Tool of Greenbaum&#x27;. Positive when &gt;= 2 of six. Output: atRisk.</bpmn:documentation>
      <bpmn:incoming>nf5</bpmn:incoming>
      <bpmn:outgoing>nf6</bpmn:outgoing>
      <bpmn:ioSpecification>
        <bpmn:dataInput id="BusinessRuleTask_Greenbaum_namespace" name="namespace" />
        <bpmn:dataInput id="BusinessRuleTask_Greenbaum_model" name="model" />
        <bpmn:dataInput id="BusinessRuleTask_Greenbaum_decision" name="decision" />
        <bpmn:dataInput id="BusinessRuleTask_Greenbaum_di_historyOfSignificantTrauma" name="historyOfSignificantTrauma" />
        <bpmn:dataInput id="BusinessRuleTask_Greenbaum_di_historyOfRunningAway" name="historyOfRunningAway" />
        <bpmn:dataInput id="BusinessRuleTask_Greenbaum_di_historyOfAlcoholOrDrugAbuse" name="historyOfAlcoholOrDrugAbuse" />
        <bpmn:dataInput id="BusinessRuleTask_Greenbaum_di_everInvolvedWithLawEnforcement" name="everInvolvedWithLawEnforcement" />
        <bpmn:dataInput id="BusinessRuleTask_Greenbaum_di_historyOfSTD" name="historyOfSTD" />
        <bpmn:dataInput id="BusinessRuleTask_Greenbaum_di_numberOfSexualPartners" name="numberOfSexualPartners" />
        <bpmn:dataOutput id="BusinessRuleTask_Greenbaum_do" name="atRisk" />
        <bpmn:inputSet>
          <bpmn:dataInputRefs>BusinessRuleTask_Greenbaum_namespace</bpmn:dataInputRefs>
          <bpmn:dataInputRefs>BusinessRuleTask_Greenbaum_model</bpmn:dataInputRefs>
          <bpmn:dataInputRefs>BusinessRuleTask_Greenbaum_decision</bpmn:dataInputRefs>
          <bpmn:dataInputRefs>BusinessRuleTask_Greenbaum_di_historyOfSignificantTrauma</bpmn:dataInputRefs>
          <bpmn:dataInputRefs>BusinessRuleTask_Greenbaum_di_historyOfRunningAway</bpmn:dataInputRefs>
          <bpmn:dataInputRefs>BusinessRuleTask_Greenbaum_di_historyOfAlcoholOrDrugAbuse</bpmn:dataInputRefs>
          <bpmn:dataInputRefs>BusinessRuleTask_Greenbaum_di_everInvolvedWithLawEnforcement</bpmn:dataInputRefs>
          <bpmn:dataInputRefs>BusinessRuleTask_Greenbaum_di_historyOfSTD</bpmn:dataInputRefs>
          <bpmn:dataInputRefs>BusinessRuleTask_Greenbaum_di_numberOfSexualPartners</bpmn:dataInputRefs>
        </bpmn:inputSet>
        <bpmn:outputSet><bpmn:dataOutputRefs>BusinessRuleTask_Greenbaum_do</bpmn:dataOutputRefs></bpmn:outputSet>
      </bpmn:ioSpecification>
      <bpmn:dataInputAssociation id="BusinessRuleTask_Greenbaum_a_namespace">
        <bpmn:targetRef>BusinessRuleTask_Greenbaum_namespace</bpmn:targetRef>
        <bpmn:assignment><bpmn:from>http://harper.health/dmn/greenbaum</bpmn:from><bpmn:to>BusinessRuleTask_Greenbaum_namespace</bpmn:to></bpmn:assignment>
      </bpmn:dataInputAssociation>
      <bpmn:dataInputAssociation id="BusinessRuleTask_Greenbaum_a_model">
        <bpmn:targetRef>BusinessRuleTask_Greenbaum_model</bpmn:targetRef>
        <bpmn:assignment><bpmn:from>GreenbaumScreen</bpmn:from><bpmn:to>BusinessRuleTask_Greenbaum_model</bpmn:to></bpmn:assignment>
      </bpmn:dataInputAssociation>
      <bpmn:dataInputAssociation id="BusinessRuleTask_Greenbaum_a_decision">
        <bpmn:targetRef>BusinessRuleTask_Greenbaum_decision</bpmn:targetRef>
        <bpmn:assignment><bpmn:from>Screening Tool of Greenbaum</bpmn:from><bpmn:to>BusinessRuleTask_Greenbaum_decision</bpmn:to></bpmn:assignment>
      </bpmn:dataInputAssociation>
      <bpmn:dataInputAssociation id="na5">
        <bpmn:sourceRef>Data_Trauma</bpmn:sourceRef>
        <bpmn:targetRef>BusinessRuleTask_Greenbaum_di_historyOfSignificantTrauma</bpmn:targetRef>
      </bpmn:dataInputAssociation>
      <bpmn:dataInputAssociation id="na6">
        <bpmn:sourceRef>Data_RunAway</bpmn:sourceRef>
        <bpmn:targetRef>BusinessRuleTask_Greenbaum_di_historyOfRunningAway</bpmn:targetRef>
      </bpmn:dataInputAssociation>
      <bpmn:dataInputAssociation id="na7">
        <bpmn:sourceRef>Data_AlcoholDrug</bpmn:sourceRef>
        <bpmn:targetRef>BusinessRuleTask_Greenbaum_di_historyOfAlcoholOrDrugAbuse</bpmn:targetRef>
      </bpmn:dataInputAssociation>
      <bpmn:dataInputAssociation id="na8">
        <bpmn:sourceRef>Data_LawEnf</bpmn:sourceRef>
        <bpmn:targetRef>BusinessRuleTask_Greenbaum_di_everInvolvedWithLawEnforcement</bpmn:targetRef>
      </bpmn:dataInputAssociation>
      <bpmn:dataInputAssociation id="na9">
        <bpmn:sourceRef>Data_STD</bpmn:sourceRef>
        <bpmn:targetRef>BusinessRuleTask_Greenbaum_di_historyOfSTD</bpmn:targetRef>
      </bpmn:dataInputAssociation>
      <bpmn:dataInputAssociation id="na10">
        <bpmn:sourceRef>Data_Partners</bpmn:sourceRef>
        <bpmn:targetRef>BusinessRuleTask_Greenbaum_di_numberOfSexualPartners</bpmn:targetRef>
      </bpmn:dataInputAssociation>
      <bpmn:dataOutputAssociation id="BusinessRuleTask_Greenbaum_doa">
        <bpmn:sourceRef>BusinessRuleTask_Greenbaum_do</bpmn:sourceRef>
        <bpmn:targetRef>Prop_atRisk</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:businessRuleTask>
    <bpmn:exclusiveGateway id="Gateway_AtRisk" name="At risk?" gatewayDirection="Diverging" default="nf9">
      <bpmn:incoming>nf6</bpmn:incoming>
      <bpmn:outgoing>nf7</bpmn:outgoing>
      <bpmn:outgoing>nf9</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:scriptTask id="Task_DraftReferral" name="Draft referral" scriptFormat="http://www.java.com/java">
      <bpmn:documentation>Creates a DRAFT social-work referral (FHIR Task status draft, intent proposal). It does not route to the Social Worker; a Licensed Independent Practitioner finalizes it in the Practitioner sub-process.</bpmn:documentation>
      <bpmn:incoming>nf7</bpmn:incoming>
      <bpmn:outgoing>nf8</bpmn:outgoing>
      <bpmn:script>kcontext.setVariable(&quot;referralStatus&quot;, &quot;draft&quot;);</bpmn:script>
    </bpmn:scriptTask>
    <bpmn:endEvent id="End_SexTraffickingSuspected" name="Referral drafted">
      <bpmn:incoming>nf8</bpmn:incoming>
      <bpmn:signalEventDefinition id="SED_End_SexTraffickingSuspected" signalRef="Signal_ReferralDrafted" />
    </bpmn:endEvent>
    <bpmn:endEvent id="End_NoSexTrafficking" name="No sex trafficking suspected">
      <bpmn:incoming>nf9</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="End_ContinueCare" name="Continue Care">
      <bpmn:incoming>nf10</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:dataObjectReference id="Data_StandingOrder" name="Standing order for survey administration?" dataObjectRef="Obj_Data_StandingOrder" />
    <bpmn:dataObject id="Obj_Data_StandingOrder" />
    <bpmn:dataObjectReference id="Data_HighRiskCC" name="High risk chief complaint?" dataObjectRef="Obj_Data_HighRiskCC" />
    <bpmn:dataObject id="Obj_Data_HighRiskCC" />
    <bpmn:dataObjectReference id="Data_AgeYears" name="Age in years" dataObjectRef="Obj_Data_AgeYears" />
    <bpmn:dataObject id="Obj_Data_AgeYears" />
    <bpmn:dataObjectReference id="Data_ShouldScreen" name="Should the patient be screened?" dataObjectRef="Obj_Data_ShouldScreen" />
    <bpmn:dataObject id="Obj_Data_ShouldScreen" />
    <bpmn:dataObjectReference id="Data_Trauma" name="History of significant trauma?" dataObjectRef="Obj_Data_Trauma" />
    <bpmn:dataObject id="Obj_Data_Trauma" />
    <bpmn:dataObjectReference id="Data_RunAway" name="History of running away from home?" dataObjectRef="Obj_Data_RunAway" />
    <bpmn:dataObject id="Obj_Data_RunAway" />
    <bpmn:dataObjectReference id="Data_AlcoholDrug" name="History of alcohol or drug abuse?" dataObjectRef="Obj_Data_AlcoholDrug" />
    <bpmn:dataObject id="Obj_Data_AlcoholDrug" />
    <bpmn:dataObjectReference id="Data_LawEnf" name="Ever involved with law enforcement?" dataObjectRef="Obj_Data_LawEnf" />
    <bpmn:dataObject id="Obj_Data_LawEnf" />
    <bpmn:dataObjectReference id="Data_STD" name="History of sexually transmitted disease?" dataObjectRef="Obj_Data_STD" />
    <bpmn:dataObject id="Obj_Data_STD" />
    <bpmn:dataObjectReference id="Data_Partners" name="Number of sexual partners" dataObjectRef="Obj_Data_Partners" />
    <bpmn:dataObject id="Obj_Data_Partners" />
    <bpmn:dataObjectReference id="Data_AtRiskQ" name="Is the patient at risk for being involved in sex trafficking?" dataObjectRef="Obj_Data_AtRiskQ" />
    <bpmn:dataObject id="Obj_Data_AtRiskQ" />
    <bpmn:sequenceFlow id="nf1" sourceRef="StartEvent_Nurse" targetRef="ManualTask_TriageData" />
    <bpmn:sequenceFlow id="nf2" sourceRef="ManualTask_TriageData" targetRef="BusinessRuleTask_EDPrescreen" />
    <bpmn:sequenceFlow id="nf3" sourceRef="BusinessRuleTask_EDPrescreen" targetRef="Gateway_Screen" />
    <bpmn:sequenceFlow id="nf4" name="Yes" sourceRef="Gateway_Screen" targetRef="ManualTask_NurseCollects">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression" language="http://www.java.com/java">return shouldScreen == true;</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="nf5" sourceRef="ManualTask_NurseCollects" targetRef="BusinessRuleTask_Greenbaum" />
    <bpmn:sequenceFlow id="nf6" sourceRef="BusinessRuleTask_Greenbaum" targetRef="Gateway_AtRisk" />
    <bpmn:sequenceFlow id="nf7" name="Yes" sourceRef="Gateway_AtRisk" targetRef="Task_DraftReferral">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression" language="http://www.java.com/java">return atRisk == true;</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="nf8" sourceRef="Task_DraftReferral" targetRef="End_SexTraffickingSuspected" />
    <bpmn:sequenceFlow id="nf9" name="No" sourceRef="Gateway_AtRisk" targetRef="End_NoSexTrafficking" />
    <bpmn:sequenceFlow id="nf10" name="No" sourceRef="Gateway_Screen" targetRef="End_ContinueCare" />
  </bpmn:process>
  <bpmn:signal id="Signal_ReferralDrafted" name="Referral drafted" />
  <bpmndi:BPMNDiagram id="Diag_Process_Nurse_Sub">
    <bpmndi:BPMNPlane id="Plane_Process_Nurse_Sub" bpmnElement="Process_Nurse_Sub">
      <bpmndi:BPMNShape id="Shape_StartEvent_Nurse" bpmnElement="StartEvent_Nurse">
        <dc:Bounds x="152" y="462" width="36" height="36" />
      </bpmndi:BPMNShape>
