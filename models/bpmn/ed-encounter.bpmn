<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
                  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
                  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
                  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  id="Definitions_EDEncounter"
                  targetNamespace="http://harper.health/bpmn/ed-encounter"
                  exporter="Project Harper" exporterVersion="0.1">

  <bpmn:itemDefinition id="ItemString" structureRef="java.lang.String" />
  <bpmn:itemDefinition id="ItemBoolean" structureRef="java.lang.Boolean" />

  <bpmn:process id="Process_EDEncounter" name="ED Encounter" isExecutable="true">
    <bpmn:documentation>End-to-end orchestration of a single ED encounter — one process instance per patient visit, and the reporting spine for the pathway. Invokes the Registrar, Nurse, and (when the Nurse raises a draft referral) Practitioner sub-processes. The five-pool collaboration in ed-trafficking-detection.bpmn documents the same pathway as participant choreography; this process is what executes.</bpmn:documentation>

    <bpmn:property id="Prop_encounterId" name="encounterId" itemSubjectRef="ItemString" />
    <bpmn:property id="Prop_referralStatus" name="referralStatus" itemSubjectRef="ItemString" />
    <bpmn:property id="Prop_atRisk" name="atRisk" itemSubjectRef="ItemBoolean" />

    <bpmn:startEvent id="StartEvent_Encounter" name="Patient arrives at ED">
      <bpmn:outgoing>Flow_1</bpmn:outgoing>
    </bpmn:startEvent>

    <bpmn:callActivity id="CallActivity_Registrar" name="Registration" calledElement="Process_Registrar_Sub">
      <bpmn:documentation>Registration, triage room, initial data collection, chief complaint, outside records.</bpmn:documentation>
      <bpmn:incoming>Flow_1</bpmn:incoming>
      <bpmn:outgoing>Flow_2</bpmn:outgoing>
    </bpmn:callActivity>

    <bpmn:callActivity id="CallActivity_Nurse" name="Nurse assessment" calledElement="Process_Nurse_Sub">
      <bpmn:documentation>ED Prescreen (DMN) and, when indicated, the Greenbaum screen (DMN). Raises a DRAFT referral when the patient is at risk.</bpmn:documentation>
      <bpmn:incoming>Flow_2</bpmn:incoming>
      <bpmn:outgoing>Flow_3</bpmn:outgoing>
      <bpmn:ioSpecification id="IOSpec_Nurse">
        <bpmn:dataOutput id="CallActivity_Nurse_atRisk" name="atRisk" />
        <bpmn:dataOutput id="CallActivity_Nurse_referralStatus" name="referralStatus" />
        <bpmn:inputSet id="InputSet_Nurse" />
        <bpmn:outputSet id="OutputSet_Nurse">
          <bpmn:dataOutputRefs>CallActivity_Nurse_atRisk</bpmn:dataOutputRefs>
          <bpmn:dataOutputRefs>CallActivity_Nurse_referralStatus</bpmn:dataOutputRefs>
        </bpmn:outputSet>
      </bpmn:ioSpecification>
      <bpmn:dataOutputAssociation id="DOA_Nurse_atRisk">
        <bpmn:sourceRef>CallActivity_Nurse_atRisk</bpmn:sourceRef>
        <bpmn:targetRef>Prop_atRisk</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
      <bpmn:dataOutputAssociation id="DOA_Nurse_referralStatus">
        <bpmn:sourceRef>CallActivity_Nurse_referralStatus</bpmn:sourceRef>
        <bpmn:targetRef>Prop_referralStatus</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:callActivity>

    <bpmn:exclusiveGateway id="Gateway_DraftRaised" name="Draft referral raised?" gatewayDirection="Diverging" default="Flow_6">
      <bpmn:incoming>Flow_3</bpmn:incoming>
      <bpmn:outgoing>Flow_4</bpmn:outgoing>
      <bpmn:outgoing>Flow_6</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <bpmn:callActivity id="CallActivity_Practitioner" name="Practitioner review" calledElement="Process_LIP_Sub">
      <bpmn:documentation>Examination, Alarm Signs (DMN), and practitioner finalization of the draft referral — the single point that signals the Social Worker.</bpmn:documentation>
      <bpmn:incoming>Flow_4</bpmn:incoming>
      <bpmn:outgoing>Flow_5</bpmn:outgoing>
    </bpmn:callActivity>

    <bpmn:endEvent id="EndEvent_Referred" name="Referral finalized">
      <bpmn:incoming>Flow_5</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:endEvent id="EndEvent_ContinueCare" name="Continue care">
      <bpmn:incoming>Flow_6</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:sequenceFlow id="Flow_1" sourceRef="StartEvent_Encounter" targetRef="CallActivity_Registrar" />
    <bpmn:sequenceFlow id="Flow_2" sourceRef="CallActivity_Registrar" targetRef="CallActivity_Nurse" />
    <bpmn:sequenceFlow id="Flow_3" sourceRef="CallActivity_Nurse" targetRef="Gateway_DraftRaised" />
    <bpmn:sequenceFlow id="Flow_4" name="yes" sourceRef="Gateway_DraftRaised" targetRef="CallActivity_Practitioner">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression" language="http://www.java.com/java">return "draft".equals(referralStatus);</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_5" sourceRef="CallActivity_Practitioner" targetRef="EndEvent_Referred" />
    <bpmn:sequenceFlow id="Flow_6" name="no" sourceRef="Gateway_DraftRaised" targetRef="EndEvent_ContinueCare" />
  </bpmn:process>

  <bpmndi:BPMNDiagram id="Diagram_EDEncounter">
    <bpmndi:BPMNPlane id="Plane_EDEncounter" bpmnElement="Process_EDEncounter">
      <bpmndi:BPMNShape id="Shape_Start" bpmnElement="StartEvent_Encounter">
        <dc:Bounds x="150" y="102" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Registrar" bpmnElement="CallActivity_Registrar">
        <dc:Bounds x="240" y="85" width="130" height="70" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Nurse" bpmnElement="CallActivity_Nurse">
        <dc:Bounds x="420" y="85" width="130" height="70" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Gateway" bpmnElement="Gateway_DraftRaised">
        <dc:Bounds x="600" y="100" width="40" height="40" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Practitioner" bpmnElement="CallActivity_Practitioner">
        <dc:Bounds x="700" y="85" width="140" height="70" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_EndReferred" bpmnElement="EndEvent_Referred">
        <dc:Bounds x="890" y="102" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_EndContinue" bpmnElement="EndEvent_ContinueCare">
        <dc:Bounds x="602" y="230" width="36" height="36" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNEdge id="Edge_1" bpmnElement="Flow_1">
        <di:waypoint x="186" y="120" /><di:waypoint x="240" y="120" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_2" bpmnElement="Flow_2">
        <di:waypoint x="370" y="120" /><di:waypoint x="420" y="120" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_3" bpmnElement="Flow_3">
        <di:waypoint x="550" y="120" /><di:waypoint x="600" y="120" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_4" bpmnElement="Flow_4">
        <di:waypoint x="640" y="120" /><di:waypoint x="700" y="120" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_5" bpmnElement="Flow_5">
        <di:waypoint x="840" y="120" /><di:waypoint x="890" y="120" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_6" bpmnElement="Flow_6">
        <di:waypoint x="620" y="140" /><di:waypoint x="620" y="230" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
