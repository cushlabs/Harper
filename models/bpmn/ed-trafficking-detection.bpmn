<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
                  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
                  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
                  id="Definitions_Harper_ED"
                  targetNamespace="http://harper.health/bpmn/ed-trafficking-detection"
                  exporter="Project Harper (reconstructed from diagram)" exporterVersion="0.2">

  <!-- Imports let the call activities resolve the separate sub-process files. -->
  <bpmn:import importType="http://www.omg.org/spec/BPMN/20100524/MODEL"
               location="registrar.bpmn"
               namespace="http://harper.health/bpmn/registrar" />
  <bpmn:import importType="http://www.omg.org/spec/BPMN/20100524/MODEL"
               location="nurse.bpmn"
               namespace="http://harper.health/bpmn/nurse" />
  <bpmn:import importType="http://www.omg.org/spec/BPMN/20100524/MODEL"
               location="practitioner.bpmn"
               namespace="http://harper.health/bpmn/practitioner" />

  <!-- ============ COLLABORATION ============ -->
  <bpmn:collaboration id="Collaboration_ED">
    <bpmn:documentation>Top-level "Detecting Human Trafficking in the ED" orchestration. The Registrar, Nurse, and Licensed Independent Practitioner activities are call activities that invoke the separate sub-process files. The Nurse raises a DRAFT referral on a positive screen and throws a "Referral drafted" signal; the Practitioner swimlane STARTS on that signal (so it engages only when the Nurse flags at-risk), finalizes the draft, and is the SINGLE point that throws the "Suspect sex trafficking" signal, which the Social Worker pool catches to start an investigation.</bpmn:documentation>
    <bpmn:participant id="Participant_OMR" name="Outside Medical Records" />
    <bpmn:participant id="Participant_Registration" name="Registration" processRef="Process_Registration" />
    <bpmn:participant id="Participant_Nurse" name="Nurse" processRef="Process_Nurse" />
    <bpmn:participant id="Participant_LIP" name="Licensed Independent Practitioner" processRef="Process_LIP" />
    <bpmn:participant id="Participant_SW" name="Social Worker" processRef="Process_SW" />

    <bpmn:messageFlow id="MF_RequestRecords" name="Request outside records" sourceRef="CallActivity_Registrar" targetRef="Participant_OMR" />
    <bpmn:messageFlow id="MF_ReturnRecords" name="Return records" sourceRef="Participant_OMR" targetRef="CallActivity_Registrar" />
    <bpmn:messageFlow id="MF_ReadyForIntake" name="Ready for Intake" sourceRef="EndEvent_ReadyForIntake" targetRef="StartEvent_ReadyForIntake" />
  </bpmn:collaboration>

  <bpmn:itemDefinition id="ItemString" structureRef="java.lang.String" />
  <bpmn:message id="Message_ReadyForIntake" name="ReadyForIntake" itemRef="ItemString" />
  <bpmn:signal id="Signal_SuspectTrafficking" name="Suspect sex trafficking" />
  <bpmn:signal id="Signal_ReferralDrafted" name="Referral drafted" />

  <!-- ============ REGISTRATION ============ -->
  <bpmn:process id="Process_Registration" name="Registration" isExecutable="false">
    <bpmn:property id="Prop_intakeMsg" name="intakeMessage" itemSubjectRef="ItemString" />
    <bpmn:startEvent id="StartEvent_PatientArrives" name="Pediatric Patient Arrives at ED">
      <bpmn:outgoing>Flow_Reg_1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:callActivity id="CallActivity_Registrar" name="Registrar" calledElement="Process_Registrar_Sub">
      <bpmn:documentation>Invokes the Registrar sub-process (Process_Registrar_Sub). Exchanges message flows with Outside Medical Records.</bpmn:documentation>
      <bpmn:incoming>Flow_Reg_1</bpmn:incoming>
      <bpmn:outgoing>Flow_Reg_2</bpmn:outgoing>
    </bpmn:callActivity>
    <bpmn:endEvent id="EndEvent_ReadyForIntake" name="Ready for Intake">
      <bpmn:incoming>Flow_Reg_2</bpmn:incoming>
      <bpmn:dataInput id="MED_Reg_out_Input" name="event" itemSubjectRef="ItemString" />
      <bpmn:dataInputAssociation id="MED_Reg_out_DIA">
        <bpmn:sourceRef>Prop_intakeMsg</bpmn:sourceRef>
        <bpmn:targetRef>MED_Reg_out_Input</bpmn:targetRef>
      </bpmn:dataInputAssociation>
      <bpmn:inputSet id="MED_Reg_out_IS"><bpmn:dataInputRefs>MED_Reg_out_Input</bpmn:dataInputRefs></bpmn:inputSet>
      <bpmn:messageEventDefinition id="MED_Reg_out" messageRef="Message_ReadyForIntake" />
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_Reg_1" sourceRef="StartEvent_PatientArrives" targetRef="CallActivity_Registrar" />
    <bpmn:sequenceFlow id="Flow_Reg_2" sourceRef="CallActivity_Registrar" targetRef="EndEvent_ReadyForIntake" />
  </bpmn:process>

  <!-- ============ NURSE ============ -->
  <bpmn:process id="Process_Nurse" name="Nurse" isExecutable="false">
    <bpmn:property id="Prop_intakeMsg" name="intakeMessage" itemSubjectRef="ItemString" />
    <bpmn:startEvent id="StartEvent_ReadyForIntake" name="Ready for Intake">
      <bpmn:outgoing>Flow_Nurse_1</bpmn:outgoing>
      <bpmn:dataOutput id="MED_Nurse_in_Output" name="event" itemSubjectRef="ItemString" />
      <bpmn:dataOutputAssociation id="MED_Nurse_in_DOA">
        <bpmn:sourceRef>MED_Nurse_in_Output</bpmn:sourceRef>
        <bpmn:targetRef>Prop_intakeMsg</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
      <bpmn:outputSet id="MED_Nurse_in_OS"><bpmn:dataOutputRefs>MED_Nurse_in_Output</bpmn:dataOutputRefs></bpmn:outputSet>
      <bpmn:messageEventDefinition id="MED_Nurse_in" messageRef="Message_ReadyForIntake" />
    </bpmn:startEvent>
    <bpmn:callActivity id="CallActivity_Nurse" name="Nurse" calledElement="Process_Nurse_Sub">
      <bpmn:documentation>Invokes the Nurse sub-process (Process_Nurse_Sub). Raises a DRAFT social-work referral on a positive risk determination; does not route (throws no routing signal).</bpmn:documentation>
      <bpmn:incoming>Flow_Nurse_1</bpmn:incoming>
      <bpmn:outgoing>Flow_Nurse_2</bpmn:outgoing>
    </bpmn:callActivity>
    <bpmn:endEvent id="EndEvent_ReadyToExamine" name="Nurse assessment complete">
      <bpmn:incoming>Flow_Nurse_2</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_Nurse_1" sourceRef="StartEvent_ReadyForIntake" targetRef="CallActivity_Nurse" />
    <bpmn:sequenceFlow id="Flow_Nurse_2" sourceRef="CallActivity_Nurse" targetRef="EndEvent_ReadyToExamine" />
  </bpmn:process>

  <!-- ============ LICENSED INDEPENDENT PRACTITIONER ============ -->
  <bpmn:process id="Process_LIP" name="Licensed Independent Practitioner" isExecutable="false">
    <bpmn:property id="Prop_referralDraftedMsg" name="referralDrafted" itemSubjectRef="ItemString" />
    <bpmn:startEvent id="StartEvent_ReadyToExamine" name="Referral drafted">
      <bpmn:outgoing>Flow_LIP_1</bpmn:outgoing>
      <bpmn:dataOutput id="SED_LIP_in_Output" name="event" itemSubjectRef="ItemString" />
      <bpmn:dataOutputAssociation id="SED_LIP_in_DOA">
        <bpmn:sourceRef>SED_LIP_in_Output</bpmn:sourceRef>
        <bpmn:targetRef>Prop_referralDraftedMsg</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
      <bpmn:outputSet id="SED_LIP_in_OS"><bpmn:dataOutputRefs>SED_LIP_in_Output</bpmn:dataOutputRefs></bpmn:outputSet>
      <bpmn:signalEventDefinition id="SED_LIP_in" signalRef="Signal_ReferralDrafted" />
    </bpmn:startEvent>
    <bpmn:callActivity id="CallActivity_LIP" name="Licensed Independent Practitioner" calledElement="Process_LIP_Sub">
      <bpmn:documentation>Invokes the Licensed Independent Practitioner sub-process (Process_LIP_Sub). Finalizes the draft referral and throws the "Suspect sex trafficking" signal to the Social Worker — the single routing point.</bpmn:documentation>
      <bpmn:incoming>Flow_LIP_1</bpmn:incoming>
      <bpmn:outgoing>Flow_LIP_2</bpmn:outgoing>
    </bpmn:callActivity>
    <bpmn:endEvent id="EndEvent_Discharge" name="Discharge">
      <bpmn:incoming>Flow_LIP_2</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_LIP_1" sourceRef="StartEvent_ReadyToExamine" targetRef="CallActivity_LIP" />
    <bpmn:sequenceFlow id="Flow_LIP_2" sourceRef="CallActivity_LIP" targetRef="EndEvent_Discharge" />
  </bpmn:process>

  <!-- ============ SOCIAL WORKER ============ -->
  <bpmn:process id="Process_SW" name="Social Worker" isExecutable="false">
    <bpmn:property id="Prop_suspectMsg" name="suspectTrafficking" itemSubjectRef="ItemString" />
    <bpmn:startEvent id="StartEvent_SuspectTrafficking" name="Suspect sex trafficking">
      <bpmn:outgoing>Flow_SW_1</bpmn:outgoing>
      <bpmn:dataOutput id="SED_SW_Output" name="event" itemSubjectRef="ItemString" />
      <bpmn:dataOutputAssociation id="SED_SW_DOA">
        <bpmn:sourceRef>SED_SW_Output</bpmn:sourceRef>
        <bpmn:targetRef>Prop_suspectMsg</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
      <bpmn:outputSet id="SED_SW_OS"><bpmn:dataOutputRefs>SED_SW_Output</bpmn:dataOutputRefs></bpmn:outputSet>
      <bpmn:signalEventDefinition id="SED_SW" signalRef="Signal_SuspectTrafficking" />
    </bpmn:startEvent>
    <bpmn:scriptTask id="Task_SocialWorker" name="Social Worker" scriptFormat="http://www.java.com/java">
      <bpmn:incoming>Flow_SW_1</bpmn:incoming>
      <bpmn:outgoing>Flow_SW_2</bpmn:outgoing>
    
      <bpmn:script>System.out.println("Harper: Social Worker");</bpmn:script>
    </bpmn:scriptTask>
    <bpmn:endEvent id="EndEvent_Investigate" name="Investigate">
      <bpmn:incoming>Flow_SW_2</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_SW_1" sourceRef="StartEvent_SuspectTrafficking" targetRef="Task_SocialWorker" />
    <bpmn:sequenceFlow id="Flow_SW_2" sourceRef="Task_SocialWorker" targetRef="EndEvent_Investigate" />
  </bpmn:process>

  <!-- ============ DIAGRAM INTERCHANGE ============ -->
  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="Collaboration_ED">

      <bpmndi:BPMNShape id="Shape_OMR" bpmnElement="Participant_OMR" isHorizontal="true">
        <dc:Bounds x="160" y="80" width="640" height="100" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Registration" bpmnElement="Participant_Registration" isHorizontal="true">
        <dc:Bounds x="160" y="200" width="640" height="150" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Nurse" bpmnElement="Participant_Nurse" isHorizontal="true">
        <dc:Bounds x="160" y="370" width="640" height="150" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_LIP" bpmnElement="Participant_LIP" isHorizontal="true">
        <dc:Bounds x="160" y="540" width="640" height="150" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_SW" bpmnElement="Participant_SW" isHorizontal="true">
        <dc:Bounds x="160" y="710" width="640" height="150" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Shape_StartArrives" bpmnElement="StartEvent_PatientArrives">
        <dc:Bounds x="250" y="257" width="36" height="36" />
        <bpmndi:BPMNLabel><dc:Bounds x="228" y="296" width="82" height="27" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_CA_Registrar" bpmnElement="CallActivity_Registrar">
        <dc:Bounds x="350" y="240" width="110" height="70" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_EndReadyForIntake" bpmnElement="EndEvent_ReadyForIntake">
        <dc:Bounds x="520" y="257" width="36" height="36" />
        <bpmndi:BPMNLabel><dc:Bounds x="505" y="296" width="68" height="14" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Shape_StartReadyForIntake" bpmnElement="StartEvent_ReadyForIntake">
        <dc:Bounds x="250" y="427" width="36" height="36" />
        <bpmndi:BPMNLabel><dc:Bounds x="235" y="466" width="68" height="14" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_CA_Nurse" bpmnElement="CallActivity_Nurse">
        <dc:Bounds x="350" y="410" width="110" height="70" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_EndReadyToExamine" bpmnElement="EndEvent_ReadyToExamine">
        <dc:Bounds x="520" y="427" width="36" height="36" />
        <bpmndi:BPMNLabel><dc:Bounds x="503" y="466" width="72" height="14" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Shape_StartReadyToExamine" bpmnElement="StartEvent_ReadyToExamine">
        <dc:Bounds x="250" y="597" width="36" height="36" />
        <bpmndi:BPMNLabel><dc:Bounds x="233" y="636" width="72" height="14" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_CA_LIP" bpmnElement="CallActivity_LIP">
        <dc:Bounds x="350" y="580" width="110" height="70" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_EndDischarge" bpmnElement="EndEvent_Discharge">
        <dc:Bounds x="520" y="597" width="36" height="36" />
        <bpmndi:BPMNLabel><dc:Bounds x="512" y="636" width="52" height="14" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Shape_StartSuspect" bpmnElement="StartEvent_SuspectTrafficking">
        <dc:Bounds x="250" y="767" width="36" height="36" />
        <bpmndi:BPMNLabel><dc:Bounds x="226" y="806" width="86" height="27" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_TaskSW" bpmnElement="Task_SocialWorker">
        <dc:Bounds x="350" y="750" width="110" height="70" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_EndInvestigate" bpmnElement="EndEvent_Investigate">
        <dc:Bounds x="520" y="767" width="36" height="36" />
        <bpmndi:BPMNLabel><dc:Bounds x="509" y="806" width="58" height="14" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNEdge id="Edge_Reg1" bpmnElement="Flow_Reg_1">
        <di:waypoint x="286" y="275" /><di:waypoint x="350" y="275" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Reg2" bpmnElement="Flow_Reg_2">
        <di:waypoint x="460" y="275" /><di:waypoint x="520" y="275" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Nurse1" bpmnElement="Flow_Nurse_1">
        <di:waypoint x="286" y="445" /><di:waypoint x="350" y="445" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Nurse2" bpmnElement="Flow_Nurse_2">
        <di:waypoint x="460" y="445" /><di:waypoint x="520" y="445" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_LIP1" bpmnElement="Flow_LIP_1">
        <di:waypoint x="286" y="615" /><di:waypoint x="350" y="615" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_LIP2" bpmnElement="Flow_LIP_2">
        <di:waypoint x="460" y="615" /><di:waypoint x="520" y="615" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_SW1" bpmnElement="Flow_SW_1">
        <di:waypoint x="286" y="785" /><di:waypoint x="350" y="785" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_SW2" bpmnElement="Flow_SW_2">
        <di:waypoint x="460" y="785" /><di:waypoint x="520" y="785" />
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="Edge_ReqRecords" bpmnElement="MF_RequestRecords">
        <di:waypoint x="405" y="240" /><di:waypoint x="405" y="180" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_RetRecords" bpmnElement="MF_ReturnRecords">
        <di:waypoint x="440" y="180" /><di:waypoint x="440" y="240" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_MFIntake" bpmnElement="MF_ReadyForIntake">
        <di:waypoint x="538" y="293" /><di:waypoint x="538" y="350" /><di:waypoint x="268" y="350" /><di:waypoint x="268" y="427" />
      </bpmndi:BPMNEdge>

    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
