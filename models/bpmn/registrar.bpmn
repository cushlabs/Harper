<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
                  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
                  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
                  id="Definitions_Harper_Registrar"
                  targetNamespace="http://harper.health/bpmn/registrar"
                  exporter="Project Harper (reconstructed from diagram)" exporterVersion="0.2">

  <bpmn:itemDefinition id="ItemString" structureRef="java.lang.String" />

  <bpmn:process id="Process_Registrar_Sub" name="Registrar (sub-process)" isExecutable="true">
    <bpmn:documentation>Registrar sub-process: registration, triage room, initial data collection, chief complaint, and retrieval of outside medical records into the EHR. Retrieving outside records is modelled as a synchronous activity (a placeholder for a FHIR/HIE service task); the five-pool collaboration in ed-trafficking-detection.bpmn documents the same exchange as message flows with the Outside Medical Records participant.</bpmn:documentation>
    <bpmn:property id="Prop_outsideRecords" name="outsideRecords" itemSubjectRef="ItemString" />

    <bpmn:startEvent id="StartEvent_Registrar" name="">
      <bpmn:outgoing>Flow_1</bpmn:outgoing>
    </bpmn:startEvent>

    <bpmn:scriptTask id="Task_RegistrationArmband" name="Registration and armband" scriptFormat="http://www.java.com/java">
      <bpmn:incoming>Flow_1</bpmn:incoming>
      <bpmn:outgoing>Flow_2</bpmn:outgoing>
      <bpmn:script>System.out.println("Harper: Registration and armband");</bpmn:script>
    </bpmn:scriptTask>

    <bpmn:scriptTask id="Task_TriageRoom" name="Triage room" scriptFormat="http://www.java.com/java">
      <bpmn:incoming>Flow_2</bpmn:incoming>
      <bpmn:outgoing>Flow_3</bpmn:outgoing>
      <bpmn:script>System.out.println("Harper: Triage room");</bpmn:script>
    </bpmn:scriptTask>

    <bpmn:scriptTask id="Task_InitialDataCollection" name="Initial data collection" scriptFormat="http://www.java.com/java">
      <bpmn:incoming>Flow_3</bpmn:incoming>
      <bpmn:outgoing>Flow_4</bpmn:outgoing>
      <bpmn:script>System.out.println("Harper: Initial data collection");</bpmn:script>
    </bpmn:scriptTask>

    <bpmn:scriptTask id="Task_EstablishChiefComplaint" name="Establish chief complaint" scriptFormat="http://www.java.com/java">
      <bpmn:incoming>Flow_4</bpmn:incoming>
      <bpmn:outgoing>Flow_5</bpmn:outgoing>
      <bpmn:script>System.out.println("Harper: Establish chief complaint");</bpmn:script>
    </bpmn:scriptTask>

    <bpmn:scriptTask id="Task_RequestOutsideRecords" name="Request outside records" scriptFormat="http://www.java.com/java">
      <bpmn:documentation>Requests and receives records from external sources (HIE / outside medical records). Placeholder for a FHIR service task.</bpmn:documentation>
      <bpmn:incoming>Flow_5</bpmn:incoming>
      <bpmn:outgoing>Flow_6</bpmn:outgoing>
      <bpmn:script>kcontext.setVariable("outsideRecords", "retrieved");</bpmn:script>
    </bpmn:scriptTask>

    <bpmn:scriptTask id="Task_OutsideRecordsToEHR" name="Outside records to EHR" scriptFormat="http://www.java.com/java">
      <bpmn:incoming>Flow_6</bpmn:incoming>
      <bpmn:outgoing>Flow_7</bpmn:outgoing>
      <bpmn:script>System.out.println("Harper: Outside records to EHR");</bpmn:script>
    </bpmn:scriptTask>

    <bpmn:endEvent id="EndEvent_Registrar" name="">
      <bpmn:incoming>Flow_7</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:sequenceFlow id="Flow_1" sourceRef="StartEvent_Registrar" targetRef="Task_RegistrationArmband" />
    <bpmn:sequenceFlow id="Flow_2" sourceRef="Task_RegistrationArmband" targetRef="Task_TriageRoom" />
    <bpmn:sequenceFlow id="Flow_3" sourceRef="Task_TriageRoom" targetRef="Task_InitialDataCollection" />
    <bpmn:sequenceFlow id="Flow_4" sourceRef="Task_InitialDataCollection" targetRef="Task_EstablishChiefComplaint" />
    <bpmn:sequenceFlow id="Flow_5" sourceRef="Task_EstablishChiefComplaint" targetRef="Task_RequestOutsideRecords" />
    <bpmn:sequenceFlow id="Flow_6" sourceRef="Task_RequestOutsideRecords" targetRef="Task_OutsideRecordsToEHR" />
    <bpmn:sequenceFlow id="Flow_7" sourceRef="Task_OutsideRecordsToEHR" targetRef="EndEvent_Registrar" />
  </bpmn:process>

  <!-- ============ DIAGRAM INTERCHANGE ============ -->
  <bpmndi:BPMNDiagram id="BPMNDiagram_Registrar">
    <bpmndi:BPMNPlane id="BPMNPlane_Registrar" bpmnElement="Process_Registrar_Sub">
      <bpmndi:BPMNShape id="Shape_Start" bpmnElement="StartEvent_Registrar">
        <dc:Bounds x="160" y="202" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_RegArmband" bpmnElement="Task_RegistrationArmband">
        <dc:Bounds x="240" y="180" width="120" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Triage" bpmnElement="Task_TriageRoom">
        <dc:Bounds x="410" y="180" width="120" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_InitialData" bpmnElement="Task_InitialDataCollection">
        <dc:Bounds x="580" y="180" width="120" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_ChiefComplaint" bpmnElement="Task_EstablishChiefComplaint">
        <dc:Bounds x="750" y="180" width="120" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_RequestRecords" bpmnElement="Task_RequestOutsideRecords">
        <dc:Bounds x="920" y="180" width="120" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_ToEHR" bpmnElement="Task_OutsideRecordsToEHR">
        <dc:Bounds x="1090" y="180" width="120" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_End" bpmnElement="EndEvent_Registrar">
        <dc:Bounds x="1260" y="202" width="36" height="36" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNEdge id="Edge_1" bpmnElement="Flow_1">
        <di:waypoint x="196" y="220" /><di:waypoint x="240" y="220" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_2" bpmnElement="Flow_2">
        <di:waypoint x="360" y="220" /><di:waypoint x="410" y="220" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_3" bpmnElement="Flow_3">
        <di:waypoint x="530" y="220" /><di:waypoint x="580" y="220" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_4" bpmnElement="Flow_4">
        <di:waypoint x="700" y="220" /><di:waypoint x="750" y="220" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_5" bpmnElement="Flow_5">
        <di:waypoint x="870" y="220" /><di:waypoint x="920" y="220" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_6" bpmnElement="Flow_6">
        <di:waypoint x="1040" y="220" /><di:waypoint x="1090" y="220" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_7" bpmnElement="Flow_7">
        <di:waypoint x="1210" y="220" /><di:waypoint x="1260" y="220" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
